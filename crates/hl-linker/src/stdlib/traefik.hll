# Traefik router and service labels, as templates over `labels`.
#
# Every template here writes label keys and values and nothing else. The
# compiler has no Traefik-shaped knowledge to contribute — that's the
# point of #259 — so what a router *is* lives in this file, in the same
# language a homelab writes its own templates in.
#
# The set is deliberately fine-grained: one template per label, because
# a `labels` block emits every key it lists and the language has no way
# to omit one. A single `router` template taking every optional field
# would write `entrypoints=` for a router that has no entrypoints, so
# each label a router may or may not carry gets its own template and a
# caller lists the ones it wants. The composites at the bottom cover the
# common shapes over those primitives.
#
# `router` is the full router id, which is what a caller passes rather
# than a name this file derives: `"{{name}}"` for the one unnamed router
# a service may have, `"{{name}}-api"` for a named one. That mirrors the
# ids the built-ins generate, and `{{name}}` resolves in an argument, so
# the caller writes it once per invocation.

## HTTP routers

# A router's rule, which is the one label every router has.
template http_rule(router, rule) {
  labels {
    "traefik.http.routers.{{router}}.rule": "{{rule}}"
  }
}

# The entrypoints a router listens on, comma-joined into one label.
template http_entrypoints(router, entrypoints) {
  labels {
    "traefik.http.routers.{{router}}.entrypoints": "{{entrypoints}}"
  }
}

# The middleware chain, comma-joined. Each entry carries its own
# provider suffix — `"auth@file"` — since a plain string is all this
# file can hold.
template http_middlewares(router, middlewares) {
  labels {
    "traefik.http.routers.{{router}}.middlewares": "{{middlewares}}"
  }
}

# A router's priority, for when two rules both match.
template http_priority(router, priority) {
  labels {
    "traefik.http.routers.{{router}}.priority": "{{priority}}"
  }
}

# A Traefik service of this router's own, for a router that shouldn't
# share the service-wide port. Writes the pair: the router's `.service`
# pointer and that service's load-balancer port.
template http_service(router, port) {
  labels {
    "traefik.http.routers.{{router}}.service": "{{router}}"
    "traefik.http.services.{{router}}.loadbalancer.server.port": "{{port}}"
  }
}

## HTTP TLS

# TLS on, with whatever certificate Traefik's default resolver hands
# out. The bare flag and nothing else, which is the whole of what an
# HTTPS router needs when a wildcard certificate already covers it.
#
# Three templates rather than one `tls(router, resolver)`, for the same
# reason the module has no omnibus `router`: a `labels` block emits
# every key it lists, so one template taking every TLS option would
# write an empty `certresolver=` for a router that has none.
template http_tls(router) {
  labels {
    "traefik.http.routers.{{router}}.tls": "true"
  }
}

# Which resolver issues this router's certificate — the name of one of
# the `certificatesresolvers` entries in Traefik's own static
# configuration, which is where a resolver is defined and where it
# stays.
template http_tls_certresolver(router, resolver) {
  labels {
    "traefik.http.routers.{{router}}.tls.certresolver": "{{resolver}}"
  }
}

# The domains a certificate covers, for the wildcard case (#231): a
# main domain and the Subject Alternative Names beside it. `sans` takes
# a list, which interpolates comma-joined (#283) — exactly the
# separator Traefik reads that key with.
#
# `domains[0]` and no other index. The key carries an array index no
# other label here has to build, and a caller managing indices across
# separate invocations would have to keep them distinct by hand. One
# entry covers the certificate a homelab has; a second is the
# hand-written `labels` entry any label always is.
template http_tls_domains(router, main, sans) {
  labels {
    "traefik.http.routers.{{router}}.tls.domains[0].main": "{{main}}"
    "traefik.http.routers.{{router}}.tls.domains[0].sans": "{{sans}}"
  }
}

## TCP routers

# The TCP namespace, one label at a time, mirroring the HTTP set above.
# A separate set rather than a `protocol` parameter because the
# namespace is part of the label *key*, and a template can't choose a
# key by condition.
template tcp_rule(router, rule) {
  labels {
    "traefik.tcp.routers.{{router}}.rule": "{{rule}}"
  }
}

template tcp_entrypoints(router, entrypoints) {
  labels {
    "traefik.tcp.routers.{{router}}.entrypoints": "{{entrypoints}}"
  }
}

template tcp_middlewares(router, middlewares) {
  labels {
    "traefik.tcp.routers.{{router}}.middlewares": "{{middlewares}}"
  }
}

template tcp_priority(router, priority) {
  labels {
    "traefik.tcp.routers.{{router}}.priority": "{{priority}}"
  }
}

template tcp_service(router, port) {
  labels {
    "traefik.tcp.routers.{{router}}.service": "{{router}}"
    "traefik.tcp.services.{{router}}.loadbalancer.server.port": "{{port}}"
  }
}

## TCP TLS

# The HTTP TLS set, one segment over, on the same reasoning the five
# `tcp_*` templates above exist: the namespace is part of the key, so a
# TCP router's TLS can't be the HTTP template with an argument.
template tcp_tls(router) {
  labels {
    "traefik.tcp.routers.{{router}}.tls": "true"
  }
}

template tcp_tls_certresolver(router, resolver) {
  labels {
    "traefik.tcp.routers.{{router}}.tls.certresolver": "{{resolver}}"
  }
}

template tcp_tls_domains(router, main, sans) {
  labels {
    "traefik.tcp.routers.{{router}}.tls.domains[0].main": "{{main}}"
    "traefik.tcp.routers.{{router}}.tls.domains[0].sans": "{{sans}}"
  }
}

# Hand the connection to the backend still encrypted, rather than
# terminating TLS at Traefik. TCP only — there is no HTTP mirror,
# because an HTTP router that doesn't decrypt has nothing to route on.
# Zero-valued like `disable`: `passthrough` defaults to off, so the
# only reason to write the key is to turn it on.
template tcp_tls_passthrough(router) {
  labels {
    "traefik.tcp.routers.{{router}}.tls.passthrough": "true"
  }
}

## Service-wide

# The Docker network Traefik should reach this container on, which
# matters when a container sits on more than one and Traefik would
# otherwise have to guess. Takes the declaration rather than a string,
# so `$net.name` reads the real Docker name — the `name:` override when
# the declaration sets one, the identifier otherwise — and a caller
# can't accidentally pass the identifier where Docker needs the other.
#
# The compiler used to derive this label on its own, from whichever of a
# service's networks was `external`. That was the last Traefik-shaped
# thing left in codegen after #269, and it moved here at #271, in the
# same change that removed the derivation: a template writing the label
# while the compiler still derived it would collide with it.
template docker_network(net) {
  labels {
    "traefik.docker.network": "{{net.name}}"
  }
}

# The one load-balancer target a service's routers fall back to when
# none names a port of its own.
template port(port) {
  labels {
    "traefik.http.services.{{name}}.loadbalancer.server.port": "{{port}}"
  }
}

# Keep Traefik away from this container entirely.
template disable() {
  labels {
    "traefik.enable": "false"
  }
}

## Composites

# The common case: one unnamed HTTP router matching a host, and the
# port behind it. Writes `expose` as well as the label, so the port is
# written once rather than twice — the built-in `router` block derived
# its label from `expose.port` for the same reason.
template http(host, port) {
  expose $port
  with http_rule { router: "{{name}}", rule: "Host(`{{host}}`)" },
       port { port: $port }
}

# The same, for one of several named routers on a service.
template http_named(router, host, port) {
  expose $port
  with http_router { router: $router, host: $host },
       port { port: $port }
}

# `http_named`'s label half, for the second router onward (#305).
#
# The two composites above write `expose` as well as the labels, and
# `expose` holds one port, so a service can apply one of them and no
# more: a second would be a second answer to a one-answer question and
# collide. That put the cliff at exactly the point a user reaches for
# composition — the second router — and dropped them to the primitives
# for both.
#
# This is the way back up. It writes the rule label and nothing else,
# so a service names its own `expose` and its own `port` once and then
# adds as many routers as it has:
#
#   expose 8080
#   with http_router { router: "public", host: "web.example.com" },
#        http_router { router: "admin",  host: "admin.example.com" },
#        port { port: 8080 }
#
# `router` is a name rather than a full router id, matching
# `http_named` — the id is `<service>-<name>` — so moving a service off
# `http_named` keeps every argument meaning what it meant.
template http_router(router, host) {
  with http_rule { router: "{{name}}-{{router}}", rule: "Host(`{{host}}`)" }
}
