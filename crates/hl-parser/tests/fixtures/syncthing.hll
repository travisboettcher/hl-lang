# Composable templates + a service that merges them, per the design
# doc's "Composition" section.

network traefik-net {
  external
  name: "docker_default"
}

# A named Docker volume needs a top-level declaration, exactly like a
# network does — a bare name on the host side of a `volume` entry is a
# *reference* to this, not a declaration of its own.
volume syncthing-config {}

# Routing is `labels`, not a built-in field (#271). The middlewares
# entry is written as a *list* so a second template can add to it
# rather than collide with it (#288) — which is what makes
# `authenticated` below a unit you can mix into anything.
template internal_web(port) {
  networks [traefik-net]
  restart unless-stopped
  expose $port
  labels {
    "traefik.http.routers.{{name}}.rule": "Host(`{{name}}.internal.techdebtor.io`)"
    "traefik.http.routers.{{name}}.entrypoints": "web-secure"
    "traefik.http.routers.{{name}}.middlewares": ["local-ipwhitelist@file"]
  }
}

template authenticated {
  labels {
    "traefik.http.routers.{{name}}.middlewares": ["forwardAuth-authentik@file"]
  }
}

template linuxserver_app(puid, pgid) {
  env PUID = $puid
  env PGID = $pgid
}

service syncthing {
  with internal_web { port: 8384 }, authenticated, linuxserver_app { puid: 1000, pgid: 100 }
  image "lscr.io/linuxserver/syncthing:latest"
  volume syncthing-config -> "/config"
}
