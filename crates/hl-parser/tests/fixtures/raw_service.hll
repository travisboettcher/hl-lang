# A service using the dedicated `privileged`/`devices` fields (#157)
# plus `raw` for `security_opt`, the genuine long-tail Compose key that
# has no dedicated field of its own — per docs/DESIGN.md's `raw`
# passthrough example.

service cadvisor {
  image "gcr.io/cadvisor/cadvisor:latest"
  privileged
  devices ["/dev/kmsg:/dev/kmsg"]
  raw {
    security_opt: { seccomp: "unconfined" }
  }
}
