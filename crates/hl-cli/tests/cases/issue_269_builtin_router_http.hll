# #269: the built-in spelling of issue_269_std_traefik_http.hll, kept
# beside it so the two `.expected` files can be diffed. Both spellings
# compile in this stage — that's what makes #271 a walk-back rather
# than a deletion.
network proxy {
  external
  name: "docker_default"
}

service web {
  image "nginx"
  networks [proxy]
  expose 8123
  router {
    host: "web.example.com"
  }
}
