# #243: `labels` is a first-class `service` field whose entries are
# *added* to the set the rest of the service contributes rather than
# replacing it. Before this field the only way to write one extra label
# line was `raw { labels: [...] }`, which replaces the whole computed
# set and silently drops everything else — #232's report.
#
# Since #271 routing is itself written as `labels`, through `std:traefik`
# templates, so "the computed set" and "the hand-written set" are the
# same field arriving from different tiers. That makes the ordering the
# load-bearing half of this case: template tiers first, in `with`-list
# order, then the service's own body — which is what keeps a file that
# writes no `labels` of its own emitting byte-identical output to one
# written before the field existed.
use "std:traefik" as traefik

network traefik-net {
  external
  name: "docker_default"
}

service web {
  image "nginx"
  networks [traefik-net]

  with
    traefik.http { host: "web.example.com", port: 8123 },
    traefik.http_entrypoints { router: "{{name}}", entrypoints: ["web-secure"] },
    traefik.docker_network { net: traefik-net }

  labels {
    "traefik.http.routers.web.tls.domains[0].main": "internal.example.com"
    "com.example.owner": "platform-team"
  }
}
