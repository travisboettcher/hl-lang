# #243: `labels` merges across template tiers exactly as `env` does —
# same key-side uniqueness, same `merge_map`, same tier rules.
#
# What this pins, in one service:
#   - a template's entries reach the service (`com.example.owner`,
#     `com.example.audit`);
#   - the service's own body wins over a template that set the same key,
#     silently, because own always beats a template (`com.example.tier`
#     comes out `own`, not `template`);
#   - the merged order is tier order — each `with` target left to right,
#     then the body's own — which is what makes emitted label order a
#     stable function of the source.
#
# #260 removed the `defaults` tier this case used to open with. Its leg
# ("defaults loses to both") went with it; `base` below is an ordinary
# leftmost `with` target, which is what pins the ordering now.
template base {
  labels {
    "com.example.stack": "homelab"
  }
}

template owner_tag {
  labels {
    "com.example.owner": "platform-team"
    "com.example.tier": "template"
  }
}

template audit_tag {
  labels {
    "com.example.audit": "yes"
  }
}

service web {
  with base, owner_tag, audit_tag
  image "nginx"

  labels {
    "com.example.tier": "own"
  }
}
