# #183: `entrypoint` is a service-level field of its own, taking
# Compose's shell-string-or-exec-list forms and overriding the image's
# `ENTRYPOINT` — distinct from `command`, which overrides its `CMD`. It
# used to be reachable only through `raw`. Both forms are covered, plus
# a `$param` written into each (which composition has to substitute, per
# #168). The last service is named `router` on purpose: the language
# reserves no words, so a name that once collided with a built-in field
# is an ordinary identifier — and since #271 there is no `router` field
# left for it to be confused with at all.
template shell_entrypoint(ep) {
  entrypoint $ep
}

template exec_entrypoint(arg) {
  entrypoint ["/bin/sh", "-c", $arg]
}

service shell-form {
  image "alpine:3"
  entrypoint "/bin/sh -c 'do-a-thing'"
}

service exec-form {
  image "alpine:3"
  entrypoint ["/bin/sh", "-c", "do-a-thing"]
}

service both-keys {
  image "alpine:3"
  entrypoint ["/docker-entrypoint.sh"]
  command "--flag"
}

service from-shell-param {
  image "alpine:3"
  with shell_entrypoint { ep: "/entrypoint.sh --verbose" }
}

service from-exec-param {
  image "alpine:3"
  with exec_entrypoint { arg: "do-a-thing" }
}

service router {
  image "alpine:3"
  entrypoint "/docker-entrypoint.sh"
  expose 8080
  labels {
    "traefik.http.routers.{{name}}.entrypoints": "web,web-secure"
  }
}
