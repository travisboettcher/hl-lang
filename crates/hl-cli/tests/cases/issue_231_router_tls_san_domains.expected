--- compose ---
services:
  home-assistant:
    image: ghcr.io/home-assistant/home-assistant:stable
    networks:
    - traefik-net
    expose:
    - 8123
    labels:
    - traefik.docker.network=docker_default
    - traefik.http.routers.home-assistant.rule=Host(`hass.techdebtor.io`)
    - traefik.http.routers.home-assistant.entrypoints=web-secure
    - traefik.http.routers.home-assistant-internal.rule=Host(`hass.internal.techdebtor.io`)
    - traefik.http.routers.home-assistant-internal.entrypoints=web-secure
    - traefik.http.routers.home-assistant-internal.middlewares=local-ipwhitelist@file
    - traefik.http.services.home-assistant.loadbalancer.server.port=8123
    - traefik.http.routers.home-assistant-internal.tls.domains[0].main=internal.techdebtor.io
    - traefik.http.routers.home-assistant-internal.tls.domains[0].sans=*.internal.techdebtor.io
networks:
  traefik-net:
    name: docker_default
    external: true
