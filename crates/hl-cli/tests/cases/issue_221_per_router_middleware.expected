--- compose ---
services:
  gitea:
    image: gitea/gitea:latest
    networks:
    - traefik-net
    - default
    expose:
    - 3000
    labels:
    - traefik.docker.network=docker_default
    - traefik.http.routers.gitea-public.rule=Host(`git.techdebtor.io`)
    - traefik.http.routers.gitea-public.entrypoints=web-secure
    - traefik.http.routers.gitea-internal.rule=Host(`git.internal.techdebtor.io`)
    - traefik.http.routers.gitea-internal.entrypoints=web-secure
    - traefik.http.routers.gitea-internal.middlewares=local-ipwhitelist@file
    - traefik.http.services.gitea.loadbalancer.server.port=3000
  vikunja:
    image: vikunja/vikunja:latest
    networks:
    - traefik-net
    - default
    expose:
    - 3456
    labels:
    - traefik.docker.network=docker_default
    - traefik.http.routers.vikunja-public.rule=Host(`vikunja.techdebtor.io`)
    - traefik.http.routers.vikunja-public.entrypoints=web-secure
    - traefik.http.routers.vikunja-public.middlewares=forwardAuth-authentik@file
    - traefik.http.routers.vikunja-lan.rule=Host(`vikunja.techdebtor.local`)
    - traefik.http.routers.vikunja-lan.entrypoints=local
    - traefik.http.routers.vikunja-lan.middlewares=local-ipwhitelist@file,rate-limit@file
    - traefik.http.services.vikunja.loadbalancer.server.port=3456
networks:
  traefik-net:
    name: docker_default
    external: true
