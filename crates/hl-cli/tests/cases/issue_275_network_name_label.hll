# #275: a `network`/`volume` has two names — the identifier `.hll` refers
# to it by, and the real Docker name (`name:` when set) — and until now
# nothing in the language could read the second. A generated label that
# has to name a real Docker network needs it: passing the identifier
# instead compiles and is silently wrong the moment a declaration sets
# `name:`, which is exactly when an external network created by another
# Compose project is involved.
#
# Pins the shape the issue is written around: one parameter serving both
# the `networks [$net]` entry, which wants the identifier, and the label
# value, which wants `docker_default`. The two differ here on purpose.
network proxy {
  external
  name: "docker_default"
}

template caddy(net, port) {
  networks [$net]
  expose $port
  labels {
    "caddy.network": $net.name
    "caddy.upstream": "{{name}}:{{port}}"
  }
}

service jellyfin {
  image "jellyfin/jellyfin"
  with caddy { net: proxy, port: 8096 }
}
