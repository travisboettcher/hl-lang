`parse` pretty-prints the AST for one file. It is a debugging aid, so
the transcript is deliberately the whole dump for the smallest service
that parses: the point is that the shape of the AST — including the
spans and the `FileId` every node carries — is visible somewhere as
text, and that adding a field to the AST shows up here as a reviewable
diff rather than silently.

```console
$ hllc parse web.hll
Program {
    decls: [
        Service(
            Service {
                name: Ident {
                    name: "web",
                    span: Span {
                        start: 8,
                        end: 11,
                        line: 1,
                        col: 9,
                        file: FileId(
                            0,
                        ),
                    },
                },
                fields: ServiceFields {
                    image: Some(
                        Image {
                            reference: Some(
                                Str(
                                    "nginx:alpine",
                                    Span {
                                        start: 22,
                                        end: 36,
                                        line: 2,
                                        col: 9,
                                        file: FileId(
                                            0,
                                        ),
                                    },
                                ),
                            ),
                            span: Span {
                                start: 22,
                                end: 36,
                                line: 2,
                                col: 9,
                                file: FileId(
                                    0,
                                ),
                            },
                        },
                    ),
                    build: None,
                    expose: None,
                    routers: [],
                    traefik: None,
                    restart: None,
                    healthcheck: None,
                    publish: ArrowMap {
                        entries: [],
                    },
                    volumes: ArrowMap {
                        entries: [],
                    },
                    env: EnvMap {
                        entries: [],
                    },
                    labels: LabelMap {
                        entries: [],
                    },
                    raw: RawMap {
                        entries: [],
                    },
                    depends_on: [],
                    networks: [],
                    dns: [],
                    env_file: [],
                    privileged: None,
                    devices: ArrowMap {
                        entries: [],
                    },
                    container_name: None,
                    command: None,
                    entrypoint: None,
                    with: [],
                },
                span: Span {
                    start: 0,
                    end: 38,
                    line: 1,
                    col: 1,
                    file: FileId(
                        0,
                    ),
                },
            },
        ),
    ],
}

```
