use "std:traefik" as traefik

network traefik-net {
  external
  name: "docker_default"
}

service jellyfin {
  image "jellyfin/jellyfin:latest"
  restart unless-stopped
  networks [traefik-net]
  env PUID = 1000
  with
    traefik.http { host: "jellyfin.example.com", port: 8096 },
    traefik.http_entrypoints { router: "{{name}}", entrypoints: ["web-secure"] },
    traefik.http_middlewares { router: "{{name}}", middlewares: ["local-ipwhitelist@file"] }
}
