# Reusable templates, imported by service files — split out of
# hl-parser's syncthing.hll fixture to exercise a real cross-file `use`
# graph. `net.traefik-net` below resolves against *this file's own*
# `use`, per docs/DESIGN.md's Imports section, regardless of which
# service file ends up invoking these templates.

use "network.hll" as net

# Routing is `labels` since #271. The middlewares entry is a list so
# `authenticated` below can add to it rather than collide with it
# (#288), which is what keeps that template a unit you can mix in.
template internal_web(port) {
  networks [net.traefik-net]
  restart unless-stopped
  expose $port
  labels {
    "traefik.http.routers.{{name}}.rule": "Host(`{{name}}.internal.techdebtor.io`)"
    "traefik.http.routers.{{name}}.entrypoints": "web-secure"
    "traefik.http.routers.{{name}}.middlewares": ["local-ipwhitelist@file"]
  }
}

template authenticated {
  labels {
    "traefik.http.routers.{{name}}.middlewares": ["forwardAuth-authentik@file"]
  }
}

template linuxserver_app(puid, pgid) {
  env PUID = $puid
  env PGID = $pgid
}
