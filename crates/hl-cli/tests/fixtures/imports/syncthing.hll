# Same service as hl-parser's tests/fixtures/syncthing.hll, split across
# network.hll/templates.hll/storage.hll/syncthing.hll — proves the
# split-and-linked version produces identical Compose output to the
# original one-file version. syncthing.hll never itself `use`s
# network.hll directly (only templates.hll does); it only reaches
# `traefik-net` indirectly through the templates it invokes.

use "templates.hll" as common
use "storage.hll" as storage

service syncthing {
  with common.internal_web { port: 8384 }, common.authenticated, common.linuxserver_app { puid: 1000, pgid: 100 }
  image "lscr.io/linuxserver/syncthing:latest"
  # A named volume is a reference, so it imports through an alias just
  # like `net.traefik-net` does — see storage.hll for the declaration.
  volume storage.syncthing-config -> "/config"
}
